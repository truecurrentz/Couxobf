# Build / cache
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
dist/
build/
*.egg-info/

# Toolchain (built by tools/setup-luau.sh, ~200MB, never vendored)
/.luau-toolchain/

# Build artifacts from the CLI.  The ones under examples/ are tracked
# deliberately: they are the checked-in demo output, not scratch.
*.protected.luau
!examples/*.protected.luau
*.report.json
/out/
